# Porta do servidor HTTP (padrao 3000)
PORT="3000"

# Segredo para assinatura de sessao JWT (alterar em producao)
JWT_SECRET="alterar-para-segredo-forte-em-producao"

# URL publica da aplicacao (usada em callbacks e webhooks)
APP_URL="http://localhost:3000"

# Credenciais iniciais do primeiro administrador (criado apenas se nao houver usuarios)
ADMIN_INITIAL_EMAIL="admin@quatropatas.org"
ADMIN_INITIAL_PASSWORD="QuatroPatas@2026"

# Mercado Pago (opcional - necessario apenas para processar pagamentos reais PIX e Cartao)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# GEMINI_API_KEY (opcional)
GEMINI_API_KEY=""
